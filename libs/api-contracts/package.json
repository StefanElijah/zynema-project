{
  "name": "@zynema/api-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
