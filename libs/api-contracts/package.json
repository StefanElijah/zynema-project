    "api:refresh": "node scripts/refresh-openapi.mjs"
  },
  "devDependencies": {
    "orval": "^8.38.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7"
  }
}
