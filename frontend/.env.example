# Frontend environment variables
# Copy to .env.local and fill in real values

# Optional API origin. Leave blank to use the same-origin proxy (Vite in dev,
# frontend Nginx in Docker). Do not add /api/v1: generated operation paths
# already include the version prefix.
VITE_API_BASE_URL=

# Keycloak OIDC config. The SPA is a public client using authorization code +
# PKCE; there is no secret here by design.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=zynema
VITE_KEYCLOAK_CLIENT_ID=zynema-web

# HLS playback (Phase 6)
VITE_HLS_PUBLIC_URL=http://localhost:8090/hls

# Analytics (Phase 9)
VITE_SENTRY_DSN=
