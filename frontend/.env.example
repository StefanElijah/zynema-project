# Frontend environment variables
# Copy to .env.local and fill in real values

# BFF base URL (proxied via Vite dev server, or direct in prod)
VITE_BFF_URL=/api

# Keycloak OIDC config (Phase 3)
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=zynema
VITE_KEYCLOAK_CLIENT_ID=zynema-web

# HLS playback (Phase 6)
VITE_HLS_PUBLIC_URL=http://localhost:8090/hls

# Analytics (Phase 9)
VITE_SENTRY_DSN=
