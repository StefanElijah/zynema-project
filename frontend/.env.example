# Frontend environment variables
# Copy to .env.local and fill in real values

# API base path. The SPA always calls the API gateway (proxied by the Vite dev
# server and by the nginx container); the BFF sits behind the gateway.
VITE_API_BASE_URL=/api/v1

# Keycloak OIDC config. The SPA is a public client using authorization code +
# PKCE; there is no secret here by design.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=zynema
VITE_KEYCLOAK_CLIENT_ID=zynema-web

# HLS playback (Phase 6)
VITE_HLS_PUBLIC_URL=http://localhost:8090/hls

# Analytics (Phase 9)
VITE_SENTRY_DSN=
