# Generated
**/.nx/cache
**/.nx/workspace-data
**/generated/
# Exception: the API contracts client is committed on purpose. Its diff is the
# contract change and the build stays honest on a fresh clone; regenerate it
# with `pnpm api:generate` instead of editing it by hand.
!libs/api-contracts/src/generated/

# Local infra state
.pgdata/
.redisdata/

# Recovery artifacts (DO NOT commit — these are for the developer only)
.opencode-backup/

# Local config git repo (initialized separately, has its own .git)
# We DO want to track the YAML/MD config files, just not the inner .git
infra/config-repo/.git/

# Downloaded media samples (make fetch-samples)
.cache/
