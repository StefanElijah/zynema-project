# ──────────────────────────────────────────────────────────────
# Zynema environment variables template
# Copy to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────

# === Core ===
NODE_ENV=development
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=docker

# === Database (PostgreSQL) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zynema
POSTGRES_USER=zynema
POSTGRES_PASSWORD=change-me-in-real-life

# Per-service database names (database-per-service pattern)
POSTGRES_DB_CATALOG=zynema_catalog
POSTGRES_DB_USER=zynema_user
POSTGRES_DB_PAYMENT=zynema_payment
POSTGRES_DB_PLAYBACK=zynema_playback
POSTGRES_DB_AUTH=zynema_auth
POSTGRES_DB_NOTIFICATION=zynema_notification

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# === Eureka ===
EUREKA_SERVER_URL=http://eureka-server:8761/eureka
EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka/

# === Config Server ===
CONFIG_SERVER_URL=http://config-server:8888
CONFIG_SERVER_GIT_URI=file:///config-repo
CONFIG_SERVER_GIT_DEFAULT_LABEL=main

# === API Gateway ===
GATEWAY_PORT=8080
GATEWAY_ROUTES_BFF=/api/web/**

# === Keycloak (OIDC) ===
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=zynema
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-real-life
KEYCLOAK_CLIENT_ID_WEB=zynema-web
KEYCLOAK_CLIENT_ID_BFF=zynema-bff
KEYCLOAK_CLIENT_SECRET_BFF=change-me-in-real-life

# === MinIO (S3-compatible) ===
MINIO_ROOT_USER=zynema-admin
MINIO_ROOT_PASSWORD=change-me-in-real-life
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_VIDEOS=zynema-videos
MINIO_BUCKET_HLS=zynema-hls

# === Nginx HLS ===
NGINX_HLS_PORT=8090

# === Observability ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me-in-real-life
LOKI_PORT=3100
TEMPO_PORT=4318
PROMTAIL_PORT=9080

# OTLP endpoints (Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAME=zynema

# === Frontend ===
VITE_API_BASE_URL=http://localhost:8080/api/web
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=zynema
VITE_KEYCLOAK_CLIENT_ID=zynema-web

# === CI / SonarQube (private repo) ===
SONAR_TOKEN=
SONAR_HOST_URL=https://sonarcloud.io
SONAR_PROJECT_KEY=zynema-project
SONAR_ORGANIZATION=
