# ──────────────────────────────────────────────────────────────
# pnpm configuration — zynema-project
# ──────────────────────────────────────────────────────────────

# Strict engine enforcement
engine-strict=true

# Auto-install peer dependencies (Spring Boot ecosystem expects this)
auto-install-peers=true

# Disallow running install scripts from arbitrary packages (security)
# Explicit allow-list via .pnpmfile.cjs or package.json `pnpm.onlyBuiltDependencies`
enable-pre-post-scripts=false

# Speed
prefer-frozen-lockfile=true
strict-peer-dependencies=false

# Network
registry=https://registry.npmjs.org/
